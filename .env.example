# Public base URL of the deployment. Used to build absolute share/OG image URLs.
# Leave unset locally — the app falls back to the incoming request's origin.
NEXT_PUBLIC_SITE_URL=https://hh-goa.example.com

# --- Share storage -----------------------------------------------------------
# Set automatically by Vercel once a Blob store is connected to the project.
# When present, shared graphics go to Vercel Blob (required on serverless).
# When absent, an in-process map is used — fine for local dev and single-instance
# hosts, but NOT for serverless.
BLOB_READ_WRITE_TOKEN=

# Shared secret for the daily purge cron. Vercel sends it as
# `Authorization: Bearer $CRON_SECRET`. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The endpoint refuses every request while this is unset.
CRON_SECRET=

# How long a shared graphic stays retrievable, in seconds. Default: 86400 (24h).
SHARE_TTL_SECONDS=86400

# Upper bound on the in-memory share store, in megabytes. Oldest entries are
# evicted first once the cap is reached. Ignored by the Blob backend. Default: 128
SHARE_STORE_MAX_MB=128

# Share uploads allowed per IP per hour. Default: 20
SHARE_RATE_LIMIT_PER_HOUR=20
